<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle deep contact shadow behind checkmark for embossed physical elevation -->
    <path
        android:fillColor="#38000000"
        android:strokeColor="#38000000"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,56.5 L49,68.5 L73,42.5" />

    <!-- Soft diffuse ambient shadow -->
    <path
        android:fillColor="#22000000"
        android:strokeColor="#22000000"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,55.5 L49,67.5 L73,41.5" />

    <!-- Tactile bevel bottom edge (darker olive for 3D depth) -->
    <path
        android:strokeColor="#6E805B"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,54.8 L49,66.8 L73,40.8" />

    <!-- Main checkmark stroke in muted sage / olive green with subtle lighting gradient -->
    <path
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,54 L49,66 L73,40">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="66"
                android:endX="73"
                android:endY="40"
                android:type="linear">
                <item android:offset="0.0" android:color="#9CB384" />
                <item android:offset="0.4" android:color="#8FA378" />
                <item android:offset="1.0" android:color="#7D9166" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top beveled highlight edge catching soft specular light -->
    <path
        android:strokeColor="#40DCE8C8"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M38,53.2 L49,64.2 L72,39.2" />

    <!-- Center crest highlight line -->
    <path
        android:strokeColor="#25FFFFFF"
        android:strokeWidth="1.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M39,53.5 L49,63.8 L70.5,40.5" />
</vector>
